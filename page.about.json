          "settings": {
            "label": "START SIMPLE",
            "title": "Build around your basics",
            "text": "Start with a cleanser, moisturiser and daytime sunscreen. Add extra steps thoughtfully, rather than all at once."
          }
        },
        "guide_2": {
          "type": "guide",
          "settings": {
            "label": "GET TO KNOW IT",
            "title": "Give a new product its own moment",
            "text": "Introduce one new product at a time. Follow its directions and give yourself time to notice how your skin responds."
          }
        },
        "guide_3": {
          "type": "guide",
          "settings": {
            "label": "FIND YOUR FIT",
            "title": "A routine that belongs to you",
            "text": "Use each product’s ingredients and directions to guide your choices. The most useful routine is one you can keep up with."
          }
        }
