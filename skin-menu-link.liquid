{% if link.links != blank %}
<details class="skin-menu-item">
 <summary>{{ link.title | escape }} <span aria-hidden="true">⌄</span></summary>
 <ul class="skin-menu-children" role="list">
  <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
  {% for child in link.links %}
   <li>{% if child.links != blank %}
    <details><summary>{{ child.title | escape }} <span aria-hidden="true">⌄</span></summary>
     <ul role="list"><li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
     {% for grandchild in child.links %}<li><a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>{% endfor %}</ul>
    </details>
   {% else %}<a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>{% endif %}</li>
  {% endfor %}
 </ul>
</details>
{% else %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}
