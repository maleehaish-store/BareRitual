{%- assign items = section.blocks | where: 'type', 'item' -%}
<section
  class="skin-feature-strip skin-feature-strip--{{ section.settings.style }}"
  style="--strip-pad-top: {{ section.settings.padding_top }}px; --strip-pad-bottom: {{ section.settings.padding_bottom }}px;"
  {% if section.settings.heading != blank %}aria-labelledby="FeatureStrip-{{ section.id }}"{% endif %}
>
  <div class="skin-container">
    {%- if section.settings.heading != blank -%}
      <div class="skin-section-heading">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="skin-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 id="FeatureStrip-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
    {%- endif -%}
    <ul class="skin-feature-strip__grid" role="list" style="--strip-columns: {{ items.size | at_least: 1 | at_most: 4 }};">
      {%- for block in items -%}
        <li class="skin-feature" {{ block.shopify_attributes }}>
          <span class="skin-feature__number" aria-hidden="true">0{{ forloop.index }}</span>
          <h3 class="skin-feature__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<div class="skin-feature__text">{{ block.settings.text }}</div>{%- endif -%}
          {%- liquid
            assign link_ok = true
            if block.settings.link contains '/pages/'
              assign link_handle = block.settings.link | split: '/pages/' | last | split: '?' | first
              if pages[link_handle].id == blank
                assign link_ok = false
              endif
            endif
          -%}
          {%- if link_ok and block.settings.link != blank and block.settings.link_label != blank -%}
            <a class="skin-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Reassurance strip",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "style",
      "label": "Background",
      "options": [
        { "value": "sage", "label": "Sage" },
        { "value": "plain", "label": "Page background" }
      ],
      "default": "sage"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "disabled_on": { "groups": ["header"] },
  "presets": [
    {
      "name": "Reassurance strip",
      "blocks": [
        { "type": "item", "settings": { "title": "Established brands", "text": "<p>A focused edit of skincare from brands you can research and trust.</p>" } },
        { "type": "item", "settings": { "title": "Secure checkout", "text": "<p>Every order is processed through Shopify's secure checkout.</p>" } },
        { "type": "item", "settings": { "title": "Here to help", "text": "<p>Questions about an order or a product? Get in touch.</p>", "link_label": "Contact us", "link": "/pages/contact" } }
      ]
    }
  ]
}
{% endschema %}
